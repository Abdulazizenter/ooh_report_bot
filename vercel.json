{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "server.js": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/health",
      "destination": "/server.js"
    }
  ]
}
